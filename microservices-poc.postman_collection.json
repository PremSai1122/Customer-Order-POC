{
  "info": {
    "name": "Customer & Order Microservices POC",
    "description": "Local JWT auth, api-gateway routed calls (composite only), and direct-to-service calls for the customer/order/composite microservices POC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "customer_direct_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "order_direct_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - sets {{token}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    console.log('Saved local token to {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"raj\",\n  \"password\": \"S3cure!Pass\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Checks the credentials against the gateway's jwt.users map in application.yml and returns an HS256 JWT signed with jwt.secret. There is no registration endpoint and no user database - add users by editing jwt.users and restarting the gateway. Saves the token into the {{token}} collection variable for every other request."
          }
        }
      ]
    },
    {
      "name": "Gateway -> Composite Service (auth required)",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"productId\": 100,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/composite/orders",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "composite",
                "orders"
              ]
            },
            "description": "Verifies the customer exists/is active via customer-service, then creates the order via order-service."
          }
        },
        {
          "name": "Get Customer With Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/composite/customers/{{customerId}}/orders",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "composite",
                "customers",
                "{{customerId}}",
                "orders"
              ]
            },
            "description": "Combined view - one call, customer info plus every order they've placed."
          }
        }
      ],
      "description": "The only paths the gateway routes. Every request needs a bearer token from Auth > Login."
    },
    {
      "name": "Customer Service (direct, no auth)",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{customer_direct_url}}/api/customers",
              "host": [
                "{{customer_direct_url}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            }
          }
        },
        {
          "name": "Get Customer By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{customer_direct_url}}/api/customers/{{customerId}}",
              "host": [
                "{{customer_direct_url}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"phone\": \"9999900000\"\n}"
            },
            "url": {
              "raw": "{{customer_direct_url}}/api/customers",
              "host": [
                "{{customer_direct_url}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            }
          }
        },
        {
          "name": "Set Customer Status (soft delete/reactivate)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{customer_direct_url}}/api/customers/{{customerId}}/status?active=false",
              "host": [
                "{{customer_direct_url}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customerId}}",
                "status"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "false"
                }
              ]
            }
          }
        }
      ],
      "description": "api-gateway routes /api/composite/** only, so these go straight to customer-service on 8081. No token is needed.",
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Order Service (direct, no auth)",
      "item": [
        {
          "name": "Get Orders By Customer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{order_direct_url}}/api/orders?customerId={{customerId}}",
              "host": [
                "{{order_direct_url}}"
              ],
              "path": [
                "api",
                "orders"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{order_direct_url}}/api/orders/{{orderId}}",
              "host": [
                "{{order_direct_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"productId\": 200,\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{order_direct_url}}/api/orders",
              "host": [
                "{{order_direct_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{order_direct_url}}/api/orders/{{orderId}}",
              "host": [
                "{{order_direct_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        }
      ],
      "description": "api-gateway routes /api/composite/** only, so these go straight to order-service on 8082. No token is needed.",
      "auth": {
        "type": "noauth"
      }
    }
  ]
}
